{
  // The Node side: main process, preload, and the build config that describes
  // them. No DOM lib — a `document` reference in the main process is a crash,
  // not a type error to discover at runtime.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["node"]
  },
  "include": [
    "src/main",
    "src/preload",
    "src/shared",
    "src/test",
    "electron.vite.config.ts",
    "vitest.config.ts"
  ],
  // The jsdom suite's setup file lives beside the node one but belongs to the
  // other world: it is all `window`, `Element` and `Crypto`, none of which this
  // project has a `lib` for. tsconfig.web.json picks it up instead.
  "exclude": ["src/test/dom.ts"]
}
