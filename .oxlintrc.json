{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["dist/", "backups/", "seed/", "data.json"],
  "rules": {
    // Ships in `pedantic` rather than `correctness`, so it is off under the
    // categories above — but a hook called behind an early return corrupts hook
    // order for the whole component, which is a bug and not a style opinion.
    "react-hooks/rules-of-hooks": "error",

    // The automatic JSX runtime ("jsx": "react-jsx") means React never has to
    // be in scope.
    "react/react-in-jsx-scope": "off",

    // `import "./app.css"` and the Mantine style imports are side-effect
    // imports by design.
    "import/no-unassigned-import": "off",

    // @tiptap/starter-kit's default export really is the thing we want.
    "import/no-named-as-default": "off",

    // server.ts probes ports one at a time on purpose — each attempt depends
    // on the previous one having failed.
    "no-await-in-loop": "off",

    // Small helpers defined next to their only caller read better here than
    // hoisted to module scope.
    "unicorn/consistent-function-scoping": "off",

    // Recharts and Mantine take render props (`tooltipProps.content`, `tick`)
    // and invoke them directly rather than mounting them, so a closure passed
    // as a prop is the intended API, not an unstable component. Definitions in
    // render that are *not* props are still reported.
    "react/no-unstable-nested-components": ["warn", { "allowAsProps": true }],

    // Both remaining sites are per-item transforms over short arrays, not the
    // accumulator-spread pattern this rule is aimed at. In types.ts the spread
    // is load-bearing: SEED_CATEGORIES is Omit<Category, "id">[] and one seed
    // sets `untimed: true`, so listing fields explicitly would silently drop it
    // and break no-show tracking on every fresh install.
    "oxc/no-map-spread": "off"
  },
  "overrides": [
    {
      "files": ["src/server.ts", "src/storage.ts", "scripts/**"],
      "env": { "browser": false }
    }
  ]
}
