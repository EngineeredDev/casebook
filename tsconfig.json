{
  "compilerOptions": {
    // Environment. Unlike Bun's server-oriented default, this project ships a
    // browser frontend, so the DOM libs are required alongside ESNext.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["bun"],

    // Bundler mode: Bun executes the TypeScript directly and tsc only ever
    // typechecks, so nothing here is responsible for emit.
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Correctness
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true

    // noUnusedLocals / noUnusedParameters are deliberately left off: oxlint's
    // no-unused-vars already reports these as errors, and both tools honour the
    // same leading-underscore opt-out.
  },
  "include": ["src"]
}
